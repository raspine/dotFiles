export EDITOR="gvim"
export VISUAL="$EDITOR"
export FCEDIT="$EDITOR"
export SUDO_EDITOR="$EDITOR"

if test -f /home/jsc/.nvm/nvm.sh; then
  source /home/jsc/.nvm/nvm.sh
fi

if test -f /opt/XTC/15.2.1/SetEnv; then
  cd /opt/XTC/15.2.1
  source SetEnv
  cd -
fi


# ssh-agent: Plasma imports these from ~/.config/environment.d, MATE does not,
# so export them here too (same values, harmless under Plasma)
export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/ssh-agent.socket"
export SSH_ASKPASS="/usr/bin/ksshaskpass"
export SSH_ASKPASS_REQUIRE=prefer

# secrets (youtrack token etc.): one untracked KEY=value file, read by systemd via
# environment.d and exported here for the MATE session
if [ -r ~/.config/environment.d/secrets.conf ]; then
  set -a; . ~/.config/environment.d/secrets.conf; set +a
fi
